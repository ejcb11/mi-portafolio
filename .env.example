# ============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (EJEMPLO PÚBLICO)
# ============================================================================
# IMPORTANTE:
# 1. Nunca subas archivos .env reales al repositorio Git.
# 2. Solo las variables con prefijo VITE_PUBLIC_ son expuestas al cliente.
# 3. Las claves privadas (SERVICE_ROLE, API_SECRET, DB_PASSWORD) jamás deben
#    definirse en el frontend; deben residir únicamente en el backend o Edge.
# ============================================================================

VITE_PUBLIC_APP_URL=https://ejcbdev.vercel.app
VITE_PUBLIC_ENV=production
